{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["package.json", ".prettierrc", "tsconfig.json"],
  "tasks": {
    "type-check": {
      "dependsOn": ["^type-check"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json"]
    },
    "lint": {
      "dependsOn": [],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", ".eslintrc.js", "package.json"],
      "outputs": [".eslintcache"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".expo/**", "android/app/build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
